# ──────────────────────────────────────────────────────────────
# PPTMaker AI — Environment Variables
# Copy this file to .env.local and fill in the values.
# ──────────────────────────────────────────────────────────────

# OpenRouter API (https://openrouter.ai/keys)
OPENROUTER_API_KEY=your-openrouter-api-key-here

# Optional — tiered deck & image models (defaults are GPT-5.5 + Claude Sonnet/Opus + Flux)
# OPENROUTER_AGENT_GPT5=openai/gpt-5.5
# OPENROUTER_AGENT_CLAUDE=anthropic/claude-sonnet-latest
# OPENROUTER_AGENT_CLAUDE_OPUS=anthropic/claude-opus-4
# OPENROUTER_IMAGE_FLUX=black-forest-labs/flux-1.1-pro
# OPENROUTER_IMAGE_FLUX_CINEMATIC=black-forest-labs/flux-pro
# OPENROUTER_IMAGE_FLUX_ULTRA=black-forest-labs/flux-1.1-pro-ultra

# Claid.ai — image generation for Generative Fill, deck images, and Magic Edit (https://claid.ai → Integrations → API Keys)
CLAID_API_KEY=your-claid-api-key-here

# Optional fallback — Pollinations gen.pollinations.ai (used only if CLAID_API_KEY is unset)
POLLINATIONS_API_KEY=

# Supabase (https://app.supabase.com → Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# App URL (used for OpenRouter HTTP-Referer)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Electron desktop shell: URL to load in packaged builds (usually same as production NEXT_PUBLIC_APP_URL)
# ORBSTERA_LOAD_URL=https://your-app.vercel.app

# Direct HTTPS link to the Windows NSIS installer (homepage “Download for Windows”)
# NEXT_PUBLIC_WINDOWS_DESKTOP_INSTALLER_URL=https://your-cdn.example.com/Orbstera-Setup.exe

# Cloudflare R2 (S3-compatible — dashboard → R2 → Manage R2 API Tokens)
# Used for per-user presentation JSON and PPTX uploads from /api/presentations and /api/enhance-ppt.
CLOUDFLARE_R2_ENDPOINT=https://<accountid>.r2.cloudflarestorage.com
CLOUDFLARE_R2_ACCESS_KEY=your-r2-access-key-id
CLOUDFLARE_R2_SECRET_KEY=your-r2-secret-access-key
CLOUDFLARE_R2_BUCKET_NAME=your-bucket-name
# Optional: public bucket URL or custom domain for browser-accessible object URLs.
# Required for reliable cross-device autosave when decks contain large embedded images:
# large data URLs are uploaded directly to R2 (presigned PUT) and replaced with this HTTPS base.
# NEXT_PUBLIC_CLOUDFLARE_R2_PUBLIC_URL=https://pub-xxx.r2.dev

# Upstash Redis (https://console.upstash.com) — required in production for rate limits
UPSTASH_REDIS_REST_URL=your-upstash-redis-url
UPSTASH_REDIS_REST_TOKEN=your-upstash-redis-token

# Production scale (required for thousands of DAU — see docs/SCALING.md)
# GENERATE_WORKER_ENABLED=true
# GENERATE_ASYNC_DEFAULT=true
# GENERATE_USE_JOB_QUEUE=true
# WORKER_INTERNAL_SECRET=long-random-secret
# REDIS_URL=rediss://... (BullMQ / ioredis — Upstash TCP URL)
#
# Optional overrides:
# GENERATE_USE_JOB_QUEUE=false
# GENERATE_ASYNC_DEFAULT=false
# GENERATE_WORKER_ENABLED=false
# GENERATE_ASYNC_SLIDE_THRESHOLD=12
# EXPORT_ASYNC_SLIDE_THRESHOLD=12
# WORKER_INTERNAL_SECRET=long-random-secret
# REDIS_URL=rediss://... (BullMQ / ioredis — Upstash TCP URL)
# UPSTASH_REDIS_URL=rediss://... (alias for worker)
# GENERATE_WORKER_CONCURRENCY=2
# Inline worker (default): no Vercel callback — needs SUPABASE_SERVICE_ROLE_KEY on worker host
# GENERATE_WORKER_USE_HTTP_CALLBACK=false
# Parallel data: URL uploads during cloud save (client, default 6)
# NEXT_PUBLIC_CLOUD_SAVE_OFFLOAD_CONCURRENCY=6
# Redis fast-path credit reserve before Postgres RPC (default on when Upstash configured)
# CREDITS_REDIS_FAST_PATH=false
# EXPORT_WORKER_CONCURRENCY=2
# EXPORT_WORKER_INLINE=true
# Per-plan OpenRouter keys (optional cost isolation)
# OPENROUTER_API_KEY_CREATOR_PRO=
# OPENROUTER_API_KEY_STUDENT_PRO=
# R2_INDEX_SHARD_SIZE=200

# Dev only: non-atomic credit fallback if consume_credits_atomic_v2 migration is missing
# ALLOW_CREDIT_LEGACY_FALLBACK=false

# Optional: global AI spend cap before economy routing (USD)
# AI_SPEND_ECONOMY_THRESHOLD_USD=500

# Dodo Payments (https://dodopayments.com)
DODO_PAYMENTS_API_KEY=your-dodo-api-key
DODO_PAYMENTS_ENDPOINT=https://test.dodopayments.com/api
DODO_STUDENT_PRO_ID=pdp_xxx
DODO_CREATOR_PRO_ID=pdp_xxx
DODO_PAYMENTS_WEBHOOK_SECRET=your-webhook-secret

# Optional: Sentry error reporting (https://sentry.io) — enables `instrumentation.ts` + `src/sentry.*.config.ts`
# SENTRY_DSN=https://xxx@xxx.ingest.sentry.io/xxx
# Optional trace sampling 0–1 (default 0.1 server, 0.05 edge)
# SENTRY_TRACES_SAMPLE_RATE=0.1
# SENTRY_ENVIRONMENT=production

# Contact form (Resend — https://resend.com/api-keys)
# When both are set, /contact submits POST /api/contact and sends email via Resend.
RESEND_API_KEY=re_xxxxxxxx
# Inbox that receives contact form submissions (your team email)
CONTACT_TO_EMAIL=you@yourdomain.com
# Optional. Must be a verified sender in Resend (e.g. Orbstera <onboarding@resend.dev> for testing, or your domain)
# RESEND_FROM_EMAIL=Orbstera <hello@yourdomain.com>
