# Copy to Railway / Render "Raw env" (values = same as Vercel Production)
# See docs/WORKER_DEPLOY.md

NODE_ENV=production

# Upstash — REST (job metadata + export queue) + TCP (BullMQ generate)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
REDIS_URL=rediss://default:YOUR_TOKEN@YOUR_HOST.upstash.io:6379

# Must match Vercel
GENERATE_WORKER_ENABLED=true
GENERATE_ASYNC_DEFAULT=true
GENERATE_USE_JOB_QUEUE=true
WORKER_INTERNAL_SECRET=

NEXT_PUBLIC_APP_URL=https://your-app.vercel.app
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
OPENROUTER_API_KEY=

CLOUDFLARE_R2_ENDPOINT=
CLOUDFLARE_R2_ACCESS_KEY=
CLOUDFLARE_R2_SECRET_KEY=
CLOUDFLARE_R2_BUCKET_NAME=
NEXT_PUBLIC_CLOUDFLARE_R2_PUBLIC_URL=

# Tuning (~30k DAU)
GENERATE_WORKER_CONCURRENCY=6
EXPORT_WORKER_CONCURRENCY=2
GENERATE_WORKER_USE_HTTP_CALLBACK=false

# Optional — copy from Vercel if used
# CLAID_API_KEY=
# OPENROUTER_API_KEY_CREATOR_PRO=
# OPENROUTER_API_KEY_STUDENT_PRO=
