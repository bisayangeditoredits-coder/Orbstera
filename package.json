{
  "name": "orbstera",
  "version": "0.1.0",
  "private": true,
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "electron:write-load-url": "node scripts/write-electron-load-url.mjs",
    "electron:dev": "concurrently -k -n web,desk \"next dev\" \"wait-on http://127.0.0.1:3000 && cross-env ORBSTERA_LOAD_URL=http://127.0.0.1:3000 electron .\"",
    "electron:preview": "npm run build && concurrently -k -n web,desk \"next start -p 3000\" \"wait-on http://127.0.0.1:3000 && cross-env ORBSTERA_LOAD_URL=http://127.0.0.1:3000 electron .\"",
    "electron:pack": "npm run electron:write-load-url && electron-builder --config electron-builder.yml --win",
    "electron:pack:win": "npm run electron:pack"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1044.0",
    "@aws-sdk/s3-request-presigner": "^3.1044.0",
    "@sentry/nextjs": "^10.53.1",
    "@supabase/ssr": "^0.10.2",
    "@supabase/supabase-js": "^2.105.3",
    "@tanstack/react-query": "^5.100.9",
    "@tiptap/extension-color": "^3.22.5",
    "@tiptap/extension-font-family": "^3.22.5",
    "@tiptap/extension-highlight": "^3.22.5",
    "@tiptap/extension-text-style": "^3.22.5",
    "@tiptap/pm": "^3.22.5",
    "@tiptap/react": "^3.22.5",
    "@tiptap/starter-kit": "^3.22.5",
    "@types/uuid": "^10.0.0",
    "@upstash/ratelimit": "^2.0.8",
    "@upstash/redis": "^1.34.4",
    "clsx": "^2.1.1",
    "dodopayments": "^2.31.1",
    "fabric": "^7.3.1",
    "framer-motion": "^12.38.0",
    "jszip": "^3.10.1",
    "konva": "9.3.18",
    "lenis": "^1.3.23",
    "lucide-react": "^1.14.0",
    "next": "14.2.35",
    "officeparser": "^6.1.1",
    "pptxgenjs": "^4.0.1",
    "react": "^18",
    "react-dom": "^18",
    "react-dropzone": "^15.0.0",
    "react-hotkeys-hook": "^5.3.2",
    "react-konva": "^18.2.10",
    "tailwind-merge": "^3.5.0",
    "use-image": "^1.1.4",
    "uuid": "^14.0.0",
    "zod": "^4.4.3",
    "zustand": "^5.0.13"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "concurrently": "^9.1.2",
    "cross-env": "^7.0.3",
    "electron": "^34.2.0",
    "electron-builder": "^25.1.8",
    "eslint": "^8",
    "eslint-config-next": "14.2.35",
    "postcss": "^8",
    "tailwindcss": "^3.4.1",
    "typescript": "^5",
    "wait-on": "^8.0.1"
  }
}
