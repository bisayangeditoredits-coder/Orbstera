FROM node:20-alpine
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci --omit=dev --legacy-peer-deps
COPY . .
ENV NODE_ENV=production
# BullMQ generate (REDIS_URL TCP) + inline export (Upstash REST). See docs/WORKER_DEPLOY.md
CMD ["sh", "-c", "if [ -n \"$REDIS_URL\" ]; then npm run worker:generate:bullmq & npm run worker:export:inline & wait; else node scripts/process-generate-jobs.mjs & node scripts/process-export-jobs.mjs & wait; fi"]
